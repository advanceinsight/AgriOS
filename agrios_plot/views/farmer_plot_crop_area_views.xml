<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="farmer_plot_crop_area_search" model="ir.ui.view">
        <field name="name">farmer.plot.crop.area.search</field>
        <field name="model">farmer.plot.crop.area</field>
        <field name="arch" type="xml">
            <search string="Subplots">
                <field name="plot_id"/>
                <field name="crop_product_id"/>
                <field name="year_of_plantation"/>
                <separator/>
                <group name="group_by">
                    <filter
                        string="Plot"
                        name="groupby_plot_id"
                        context="{'group_by': 'plot_id'}"
                    />
                    <filter
                        string="Product"
                        name="groupby_product_id"
                        context="{'group_by': 'crop_product_id'}"
                    />
                    <filter
                        string="Year of Plantation"
                        name="groupby_year_of_plantation"
                        context="{'group_by': 'year_of_plantation'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="farmer_plot_crop_area_tree" model="ir.ui.view">
        <field name="name">farmer.plot.crop.area.tree</field>
        <field name="model">farmer.plot.crop.area</field>
        <field name="arch" type="xml">
            <list string="Subplots">
                <field name="farmer_id"/>
                <field name="plot_id" string="Farm/Main Plot"/>
                <field
                    name="crop_product_id"
                    string="Crop"
                    options="{'no_open': True,'no_quick_create': True,'no_create': True}"
                />
                <field name="acreage"/>
                <field name="plot_size" optional="hide"/>
                <field name="number_of_trees" optional="hide"/>
                <field name="year_of_plantation" optional="hide"/>
                <field name="age" optional="hide"/>
                <field name="annual_estimated_yield" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="farmer_plot_crop_area_form" model="ir.ui.view">
        <field name="name">farmer.plot.crop.area.form</field>
        <field name="model">farmer.plot.crop.area</field>
        <field name="arch" type="xml">
            <form string="Subplots">
                <sheet>
                    <group>
                        <group>
                            <field name="plot_id" options="{'no_create':True}"/>
                            <field name="crop_product_id" options="{'no_create':True}"/>
                            <field name="product_type"/>
                            <field name="acreage"/>
                        </group>
                        <group>
                            <field name="year_of_plantation"/>
                            <field name="age"/>
                            <field name="number_of_trees" invisible="product_type != 'tree_crop'"/>
                            <field name="annual_estimated_yield"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="farmer_plot_crop_area_pivot" model="ir.ui.view" >
        <field name="name">farmer.plot.crop.area.pivot</field>
        <field name="model">farmer.plot.crop.area</field>
        <field name="arch" type="xml">
            <pivot string="Subplots">
                <field name="plot_id" type="row"/>
                <field name="crop_product_id" type="row"/>
                <field name="acreage" type="measure" string="Acreage"/>
            </pivot>
        </field>
    </record>

</odoo>
