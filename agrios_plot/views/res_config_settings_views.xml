<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form - agrios_plot</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="agrios_farmer.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='agrios']" position="inside">
                <block title="Farm">
                    <setting
                        id="max_plot_size"
                        string="Max Plot Size"
                        help="Leave the value as 0.0 to allow any farm size to be set."
                    >
                        <div class="content-group">
                            <field name="max_plot_size" class="o_light_label"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
