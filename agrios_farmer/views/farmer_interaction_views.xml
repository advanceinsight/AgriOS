<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_farmer_interaction_search" model="ir.ui.view">
        <field name="name">farmer.interaction.search</field>
        <field name="model">farmer.interaction</field>
        <field name="arch" type="xml">
            <search>
            	<field name="name"/>
                <field name="farmer_id" domain="[('is_farmer','=',True)]"/>
                <separator/>
                <filter
                    string="Archived"
                    name="filter_not_active"
                    domain="[('active','=',False)]"
                />
                <group name="group_by">
                    <filter
                        string="Farmer"
                        name="groupby_farmer_id"
                        context="{'group_by': 'farmer_id'}"
                    />
                    <filter
                        string="Date"
                        name="groupby_interaction_date"
                        context="{'group_by': 'interaction_date'}"
                    />
                    <filter
                        string="Interaction Type"
                        name="groupby_interaction_type"
                        context="{'group_by': 'interaction_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_farmer_interaction_tree" model="ir.ui.view">
        <field name="name">view.farmer.interaction.tree</field>
        <field name="model">farmer.interaction</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="interaction_date"/>
                <field name="farmer_id" />
                <field name="interaction_type"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_farmer_interaction_form" model="ir.ui.view">
        <field name="name">view.farmer.interaction.form</field>
        <field name="model">farmer.interaction</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="farmer_id" options="{'no_create': True}" required="1"/>
                        </group>
                        <group>
                            <field name="interaction_date"/>
                            <field name="interaction_type"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" widget="html"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_farmer_interaction" model="ir.actions.act_window">
        <field name="name">Farmer Interactions</field>
        <field name="res_model">farmer.interaction</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Interactions Created Yet
            </p>
            <p>
                Odoo helps you easily track all Farmer Interactions (Calls, Visits, e.t.c).
                You can create this on the Offtake Agreement form.
            </p>
        </field>
    </record>

</odoo>
