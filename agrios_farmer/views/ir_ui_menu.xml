<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Root menu -->

    <menuitem
        id="agrios_menu_root"
        name="Farmers"
        web_icon="agrios_farmer,static/description/agrios_farmer.png"
        groups="group_agrios_readonly"
        sequence="150"
    />

    <!-- Farmer menu's -->

    <menuitem
        id="agrios_farmer_farmers"
        name="Farmers"
        parent="agrios_menu_root"
        action="action_verified_farmers"
        sequence="10"
    />
    <menuitem
        id="agrios_farmer_farmers_main"
        name="Farmers"
        parent="agrios_farmer_farmers"
        action="action_verified_farmers"
        sequence="10"
    />
    <menuitem
        name="Farmer Leads"
        id="agrios_farmer_leads"
        parent="agrios_farmer_farmers"
        action="action_farmer_leads"
        sequence="15"
    />
    <menuitem
        name="Farmer Groups"
        id="agrios_organisation_group"
        parent="agrios_menu_root"
        action="action_farmer_groups"
        sequence="20"
    />
    <menuitem
        name="Interactions"
        id="agrios_farmer_interaction"
        parent="agrios_menu_root"
        sequence="60"
        action="action_farmer_interaction"
        groups="group_farmer_interactions"
    />

    <!-- Configuration -->

    <menuitem
        name="Configuration"
        id="agrios_configuration"
        parent="agrios_menu_root"
        sequence="300"
        groups="group_agrios_admin"
    />
    <menuitem
        name="Settings"
        id="agrios_configuration_settings"
        parent="agrios_configuration"
        action="action_agrios_configuration_settings"
        sequence="10"
    />
    <menuitem
        name="Activity Types"
        id="agrios_configuration_activity"
        parent="agrios_configuration"
        action="mail.mail_activity_type_action"
        sequence="20"
    />
    <menuitem
        id="agrios_partner_education"
        name="Partner Education"
        parent="agrios_configuration"
        action="action_partner_education"
        sequence="30"
        groups="group_agrios_manager"
    />
    <menuitem
        id="agrios_organisation"
        name="Administration"
        parent="agrios_configuration"
        sequence="60"
    />
    <menuitem
        id="agrios_agrios_area"
        name="Areas"
        parent="agrios_organisation"
        action="action_agrios_area"
        sequence="10"
    />
    <menuitem
        name="Areas Designation"
        id="country_location_level_menu"
        parent="agrios_organisation"
        action="agrios_farmer.country_location_level_action"
        sequence="100"
        groups="group_agrios_manager"
    />

    <!--  Hide the menus unless in debug-->
    <record id="base.menu_apps" model="ir.ui.menu">
        <field name="group_ids" eval="[(6, 0,[ref('base.group_no_one')])]"/>
    </record>
    <record id="contacts.menu_contacts" model="ir.ui.menu">
        <field name="sequence" eval="160"/>
    </record>

</odoo>
