<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="farmer_certification_search" model="ir.ui.view">
        <field name="name">farmer.certification.search</field>
        <field name="model">farmer.certification</field>
        <field name="arch" type="xml">
            <search>
                <field name="farmer_id" domain="[('is_farmer','=',True)]"/>
                <field name="certification_type_id"/>
                <field name="cert_serial_num"/>
                <separator/>
                <filter
                    string="Valid"
                    name="filter_valid"
                    domain="[('posted','=',True),('force_expired','=',False),
                    ('cert_start_date','&lt;=',context_today().strftime('%Y-%m-%d')),
                    ('cert_end_date','&gt;=',context_today().strftime('%Y-%m-%d'))]"
                />
                <separator/>
                <filter string="Archived" name="filter_not_active" domain="[('active','=',False)]"/>
                <group name="group_by">
                    <filter
                        string="Farmer"
                        name="groupby_farmer_id"
                        context="{'group_by': 'farmer_id'}"
                    />
                    <filter
                        string="Certification Type"
                        name="groupby_certification_type_id"
                        context="{'group_by': 'certification_type_id'}"
                    />
                    <filter
                        string="Start Date"
                        name="groupby_cert_start_date"
                        context="{'group_by': 'cert_start_date'}"
                    />
                    <filter
                        string="End Date"
                        name="groupby_cert_end_date"
                        context="{'group_by': 'cert_end_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_certified_farmer_tree" model="ir.ui.view">
        <field name="name">view.farmer.certification.tree</field>
        <field name="model">farmer.certification</field>
        <field name="arch" type="xml">
            <list
                sample="1"
                decoration-info="style=='info'"
                decoration-muted="style=='muted'"
                decoration-success="style=='success'"
                decoration-warning="style=='warning'"
                decoration-danger="style=='danger'"
            >
                <field name="certification_type_id"/>
                <field name="farmer_id" />
                <field name="cert_serial_num" optional="show"/>
                <field name="cert_start_date"/>
                <field name="cert_end_date"/>
                <field name="origin" optional="show"/>
                <field name="state"/>
                <field name="style" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_certified_farmer_form" model="ir.ui.view">
        <field name="name">view.farmer.certification.form</field>
        <field name="model">farmer.certification</field>
        <field name="arch" type="xml">
            <form>
                <field name="active" invisible="1"/>
                <field name="valid_farmer_certification_count" invisible="1"/>
                <header>
                    <button
                        name="btn_validate"
                        string="Validate"
                        class="oe_highlight"
                        type="object"
                        data-hotkey="v"
                        invisible="state != 'draft' or valid_farmer_certification_count == 0"
                        confirm="There is another valid certification for this contact.
                        If you validate this one, that certification will be set to expired.
                        Are you sure you want to continue?"
                        groups="agrios_farmer.group_agrios_user"
                    />
                    <button
                        name="btn_validate"
                        string="Validate"
                        class="oe_highlight"
                        type="object"
                        data-hotkey="v"
                        invisible="state != 'draft' or valid_farmer_certification_count &gt; 0"
                        groups="agrios_farmer.group_agrios_user"
                    />
                    <button
                        name="btn_set_draft"
                        string="Set To Draft"
                        type="object"
                        data-hotkey="b"
                        invisible="state == 'draft' or origin != 'manual'"
                        groups="agrios_farmer.group_agrios_user"
                    />
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box"></div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        invisible="active == True"
                    />
                    <group>
                        <group>
                            <field
                                name="farmer_id"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                            <field name="cert_start_date" readonly="state != 'draft'"/>
                            <field name="final_score" readonly="state != 'draft'"/>
                            <field name="origin" invisible="True"/>
                        </group>
                        <group>
                            <field
                                name="certification_type_id"
                                options="{'no_create': True}"
                                readonly="state != 'draft'"
                            />
                            <field name="cert_end_date" force_save="1"/>
                            <field name="cert_serial_num" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Corrective Measures">
                        <field
                            name="corrective_action_ids"
                            nolabel="1"
                            colspan="2"
                            readonly="state != 'draft'"
                        >
                            <list editable="top">
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>
