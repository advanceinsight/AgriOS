<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">view.oms.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="agrios_product.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='seed_varieties']" position="before">
                <setting
                    id="farmer_contracts"
                    help="Allows the management of offtake agreement contract with the farmers."
                    company_dependent="1"
                >
                    <field name="group_farmer_contract"/>
                    <div class="content-group">

                        <div invisible="not group_farmer_contract">
                            <button
                                name="%(agrios_trade.action_farmer_contracts)d"
                                icon="oi-arrow-right"
                                type="action"
                                string="Offtake Agreements"
                                class="btn-link"
                            />
                        </div>
                        <div class="mt16" invisible="not group_farmer_contract">
                            <div>
                                <field name="a_default_contract_required" class="w-auto"/>
                                <label for="a_default_contract_required"/>
                                <span
                                    class="o_doc_link"
                                    style="cursor: help; margin-left: -7px;"
                                    title="If selected, farmers will require, by default, a valid contract
                                    to sell inputs or to buy off-takes from them. If unselected, no contract,
                                    by default, is needed. Individual cases can be changed on each farmer
                                    record form page."
                                />
                            </div>
                            <div>
                                <field name="close_expired_contracts" class="w-auto"/>
                                <label for="close_expired_contracts"/>
                                <span
                                    class="o_doc_link"
                                    style="cursor: help; margin-left: -7px;"
                                    title="If selected, expired contracts will be automatically closed by Odoo.
                                    If not, expired contracts will need to be closed manually."
                                />
                            </div>
                            <div>
                                <field name="allow_operations_out_of_phase" class="w-auto"/>
                                <label for="allow_operations_out_of_phase"/>
                                <span
                                    class="o_doc_link"
                                    style="cursor: help; margin-left: -7px;"
                                    title="If selected, input sales can be made on contracts in the harvestable
                                    phase and off-take purchases can be made on contracts on the input phase.
                                    If not, input sales can only be done on contracts on the input phase and
                                    off-take purchases can only be done on contracts on the harvestable phase."
                                />
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
            <xpath
                expr="//block[@name='operations_setting_container']"
                position="inside"
            >
                <setting
                    id="payments_in_kind"
                    help="Allows payments in kind to be done to farmers input requests."
                >
                    <field name="group_payments_in_kind"/>
                    <div class="content-group">
                        <div class="mt16" invisible="not group_payments_in_kind">
                            <div>
                                <field name="payment_in_kind_optional" class="w-auto"/>
                                <label for="payment_in_kind_optional"/>
                                <span
                                    class="o_doc_link"
                                    style="cursor: help; margin-left: -7px;"
                                    title="If selected, users will be able to decide if an off-take
                                    purchase will be paid or not by the farmer 'payment in kind' inputs.
                                    If not selected, off-take purchases will always be paid
                                    (fully or partially) by any open 'payment in kind'
                                    input sales the farmer has."
                                />
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
